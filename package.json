{
  "name": "canvas-pro",
  "version": "1.1.2",
  "private": true,
  "description": "A native Mac library and browser capture companion",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "build:mac": "npm run build:native && node scripts/build-mac.cjs",
    "update:mac": "node scripts/update-mac.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:media": "node scripts/build-native.cjs media",
    "test:integration": "electron tests/smoke-electron.cjs && electron tests/paste-smoke-electron.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "install:extension": "node scripts/install-extension-bridge.cjs",
    "test:browser": "node tests/browser-extension.cjs",
    "test:trash": "electron tests/context-trash-electron.cjs",
    "build:viewers": "node scripts/build-viewers.cjs",
    "test:formats": "electron tests/formats-electron.cjs",
    "test:reliability": "node --test tests/regressions/regressions.test.cjs && electron tests/reliability-electron.cjs",
    "test:preferences": "electron tests/preferences-electron.cjs",
    "test:capture": "electron tests/capture-network-electron.cjs",
    "test:bookmarks": "electron tests/bookmark-workflows-electron.cjs",
    "test:canvas": "electron tests/canvas-electron.cjs && electron tests/canvas-polish-electron.cjs && electron tests/canvas-lifecycle-electron.cjs && electron tests/canvas-viewer-actions-electron.cjs && electron tests/canvas-inspector-electron.cjs && electron tests/canvas-momentum-electron.cjs",
    "test:libraries": "electron tests/library-switch-electron.cjs",
    "test:audit": "node --test tests/audit-regressions.test.cjs && electron tests/audit-missing-file-electron.cjs",
    "test:stress": "node --test tests/crash-stress.test.cjs && electron tests/stress-electron.cjs",
    "package:mac": "node scripts/package-release.cjs",
    "build:smart": "node scripts/build-smart.cjs",
    "build:analysis": "node scripts/build-native.cjs analysis",
    "test:smart": "electron tests/smart-features-electron.cjs",
    "prototype": "node scripts/prototype.cjs",
    "test:prototype": "electron tests/prototype-electron.cjs",
    "build:symbols": "swiftc -module-name CanvasSymbols -module-cache-path /private/tmp/asset-swift-module-cache native/Symbols.swift -o /private/tmp/canvas-symbols && /private/tmp/canvas-symbols src/assets/symbols"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@jspawn/ghostscript-wasm": "^0.0.2",
    "@mozilla/readability": "^0.6.0",
    "@ruffle-rs/ruffle": "^0.7.1",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.15",
    "three": "^0.187.0",
    "web-ifc": "^0.0.78"
  },
  "productName": "Canvas Pro",
  "overrides": {
    "sharp": "^0.35.5"
  }
}
